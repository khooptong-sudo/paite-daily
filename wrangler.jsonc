{
  "name": "paite-daily",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/review/api/*", "/", "/index.html"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "paite-daily", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "TURNSTILE_SITE_KEY": "",
    "REVIEWERS": "{}",
    "OWNER_EMAIL": "",
    "CORPUS_REPO": "khooptong-sudo/paite-open-language-data",
    "CORPUS_BRANCH": "master"
  }
}
