{
  "name": "paite-daily",
  "workers_dev": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/api/*", "/review/api/*", "/admin/api/*", "/about", "/contributors", "/glossary", "/proverbs", "/proverbs.json", "/rules", "/rules.json", "/places", "/words.tsv", "/paite-wordlist.xml", "/paite-gboard.zip", "/audio/*", "/", "/index.html"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "paite-daily", "database_id": "2f5a853a-51cb-4fe0-bf5a-29ebce3feb12", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "paite-daily-audio" }],
  "send_email": [{ "name": "ALERT_EMAIL", "allowed_sender_addresses": ["alerts@alerts.lamkalabs.com"] }],
  "routes": [{ "pattern": "paite.lamkalabs.com", "custom_domain": true }],
  "triggers": { "crons": ["0 3 * * *", "*/15 * * * *", "0 2 * * *"] },
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFWPYZ0Pau14Cq6s",
    "CORPUS_REPO": "khooptong-sudo/paite-open-language-data",
    "CORPUS_BRANCH": "master",
    "COMMUNITY_GOAL": "1000"
  }
}
